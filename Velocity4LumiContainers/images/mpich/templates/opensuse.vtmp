@from
    {{ __base__ }}

@run
  >>> Set persistent env variables
  !envar MPICH_PATH /opt/mpich
  >>> Set local env variables
  export MPICH_VERSION {{ __version__ }}
  export MPICH_TAR http://www.mpich.org/static/downloads/${MPICH_VERSION}/mpich-${MPICH_VERSION}.tar.gz
  >>> download
  cd /opt
  wget $MPICH_TAR
  tar -xzf mpich-$MPICH_VERSION.tar.gz
  rm mpich-$MPICH_VERSION.tar.gz
  cd mpich-$MPICH_VERSION
  CC=gcc-$GCC_RELEASE CXX=g++-$GCC_RELEASE  \
        ./configure --prefix=$MPICH_PATH  \
            --with-hip-lib=$ROCM_PATH/lib/  \
            --with-hip-include=$ROCM_PATH/include/  \
            --with-libfabric=$LIBFABRIC_PATH \
            --disable-fortran  \
            --enable-fast=all,O3  \
            --with-device=ch4:ofi \
             --with-pm=none \
            --disable-silent-rules \
            --enable-debuginfo \
            --enable-shared
    make -j 12
    make install
    cd /
    rm -rf /opt/mpich-$MPICH_VERSION/
