@from
    {{ __base__ }}

@run
    >>> Set Environment variables
    !envar ROCM_RPM https://repo.radeon.com/amdgpu-install/{{ __version__ }}/sle/$OPENSUSE_VERSION/amdgpu-install-{{ repo_version }}.noarch.rpm
    !envar ROCM_RELEASE {{ __version__ }}
    >>> install AMD installer
    zypper --no-gpg-checks -n install $ROCM_RPM
    sed -i 's#gpgcheck=1#gpgcheck=0#g' /etc/zypp/repos.d/*.repo
    OPENSUSE_MINOR="${OPENSUSE_VERSION#*.}"
    zypper refresh
    amdgpu-install -y --no-dkms --usecase=rocm --rocmrelease=$ROCM_RELEASE
    zypper cc -a
    zypper --no-gpg-checks -n install -y --force miopen-hip-gfx90akdb
    zypper --no-gpg-checks -n install -y --force omniperf omnitrace
    >>> Set More Env variables
    !envar ROCM_PATH /opt/rocm-{{ __version__ }}
    !envar PATH /opt/rocm-{{ __version__ }}/bin:/opt/rocm-{{ __version__ }}/llvm/bin:$PATH
    !envar LD_LIBRARY_PATH $LD_LIBRARY_PATH:/opt/rocm-{{ __version__ }}/lib
