@from
    {{ __base__ }}

@run
    >>> Build OSU benchmarks
    !envar OSU_PATH /opt/osu
    mkdir /opt/builds
    cd /opt/builds
    curl -LO  https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-{{ OSU_VERSION }}.tar.gz
    tar -xf osu-*.tar.gz
    rm -rf osu-*.tar.gz
    \
    cd /opt/builds/osu-*/
    CC=/opt/mpich/bin/mpicc CXX=/opt/mpich/bin/mpicxx \
    CFLAGS="-I$MPICH_PATH/include -D__HIP_PLATFORM_AMD__=1" \
    ./configure --enable-rocm --with-rocm=$ROCM_PATH --enable-rcclomb --with-rccl=$ROCM_PATH --prefix=$OSU_PATH
    make -j install
    cd /
    rm -rf /opt/builds;
    >>> Build RCCL tests
    git clone -b master https://github.com/rocm/rccl-tests /opt/mybuild
    sed -i 's/-std=c++14/-std=c++14 --amdgpu-target=gfx90a:xnack- --amdgpu-target=gfx90a:xnack+/g' /opt/mybuild/src/Makefile
    cd /opt/mybuild ;\
    CC=gcc-$GCC_RELEASE \
      DEBUG=${{ RCCL_DEBUG }} \
      CXX=g++-$GCC_RELEASE \
      MPI_HOME=$MPICH_PATH \
      ROCM_PATH=$ROCM_PATH \
      MPI=1 \
      NCCL_HOME=$ROCM_PATH/rccl \
      nice make -j ;\
    mkdir /opt/rccltests
    mv /opt/mybuild/build/* /opt/rccltests
    rm -rf /opt/mybuild
