@from
    {{ __base__ }}

@run
    !envar PYTORCH_ROCM_ARCH $ROCM_TARGET
    pip3 install packaging
    pip3 install --pre torch=={{ torch_version }} --index-url {{ download_url }} ; \
    pip3 install --pre torchvision=={{ torchvision_version }} --index-url {{ download_url }}
    pip3 install --pre torchaudio=={{ torch_version }} --index-url {{ download_url }}