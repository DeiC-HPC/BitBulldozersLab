@from
    {{ __base__ }}

@run
    zypper -n addrepo https://download.opensuse.org/repositories/devel:/languages:/perl/SLE_15_SP5 perl
    echo 'gpgcheck=0' >> /etc/zypp/repos.d/perl.repo
    sed -i 's#gpgcheck=1#gpgcheck=0#g' /etc/zypp/repos.d/*.repo
    zypper --no-gpg-checks -n install -y --force-resolution git cmake gcc12 \
      gcc12-c++ gcc12-fortran zlib-devel numactl gawk patch tar autoconf automake \
      libtool libjson-c-devel graphviz ncurses-devel nano which libjansson4 \
      libnl3-200 wget bzip2 gzip binutils glibc glibc-devel libgomp1
    zypper clean
    !envar GCC_RELEASE 12
    >>> Set default gcc g++ to installed release
    ln -s /usr/bin/gcc-$GCC_RELEASE /usr/bin/gcc
    ln -s /usr/bin/g++-$GCC_RELEASE /usr/bin/g++