@from
    {{ __base__ }}

@run
    >>> Add perl repo needed.
    # Apparently its not possible to use the variables with when distro@VERSION option here.
    if [[ "$OPENSUSE_VERSION" == "15.5" ]]; then
      zypper -n addrepo https://download.opensuse.org/repositories/devel:/languages:/perl/SLE_15_SP5 perl
    elif [[ "$OPENSUSE_VERSION" == "15.6" ]]; then
      zypper -n addrepo https://download.opensuse.org/repositories/devel:/languages:/perl/SLE_15_SP6 perl
    elif [[ "$OPENSUSE_VERSION" == "15.7" ]]; then
      zypper -n addrepo https://download.opensuse.org/repositories/devel:/languages:/perl/SLE_15_SP7 perl
    fi

    echo 'gpgcheck=0' >> /etc/zypp/repos.d/perl.repo
    sed -i 's#gpgcheck=1#gpgcheck=0#g' /etc/zypp/repos.d/*.repo
    zypper --non-interactive refresh
    zypper --no-gpg-checks -n install -y --force-resolution git cmake gcc12 \
      gcc12-c++ gcc12-fortran zlib-devel numactl gawk patch tar autoconf automake \
      libtool libjson-c-devel graphviz ncurses-devel nano which libjansson4 \
      libnl3-200 wget bzip2 gzip binutils glibc glibc-devel libgomp1 libnuma1 libnuma-devel patchelf
    zypper --no-gpg-checks -n install -y --force-resolution binutils-gold
    zypper clean
    !envar GCC_RELEASE 12
    >>> Set default gcc g++ to installed release
    ln -s /usr/bin/gcc-$GCC_RELEASE /usr/bin/gcc
    ln -s /usr/bin/g++-$GCC_RELEASE /usr/bin/g++