@from
    {{ __base__ }}

@run
    !envar TF_ROCM_AMDGPU_TARGETS $ROCM_TARGET
    !envar AMDGPU_TARGETS $ROCM_TARGET
    cd /opt/
    git clone https://github.com/ROCm/rocm-jax.git
    cd rocm-jax
    git checkout -b mybuild {{ git_hash }}
    python stack.py develop --rebuild-makefile
    cd jax_rocm_plugin/
    make jax_rocm_plugin
    make jax_rocm_pjrt
    make jaxlib
    cd ../build
    pip install -r requirements.txt
    cd ../jax/dist
    pip install jaxlib*
    cd ../../jax_rocm_plugin/dist
    pip install jax*