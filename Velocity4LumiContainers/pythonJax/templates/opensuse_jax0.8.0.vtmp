@from
    {{ __base__ }}

@run
    !envar TF_ROCM_AMDGPU_TARGETS $ROCM_TARGET
    !envar AMDGPU_TARGETS $ROCM_TARGET
    cd /opt/
    git clone https://github.com/jax-ml/jax
    cd jax
    git checkout -b mybuild {{ git_hash }}
    >>> make sure nvidia isnt required!
    sed -i '70s/.*/required=False,/' jaxlib/tools/build_gpu_kernels_wheel.py
    sed -i '76s/.*/required=False,/' jaxlib/tools/build_gpu_plugin_wheel.py
    python build/build.py build --wheels=jax,jaxlib,jax-rocm-plugin,jax-rocm-pjrt --rocm_amdgpu_targets=$ROCM_TARGET --rocm_path=/opt/rocm/ --clang_path=/opt/rocm/llvm/bin/clang