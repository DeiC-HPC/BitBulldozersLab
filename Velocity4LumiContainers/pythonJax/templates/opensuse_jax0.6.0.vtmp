@from
    {{ __base__ }}

@run
    !envar TF_ROCM_AMDGPU_TARGETS gfx90a
    !envar AMDGPU_TARGETS gfx90a
    cd /opt/
    zypper -n addrepo  https://download.opensuse.org/repositories/devel:tools:building/15.6/devel:tools:building.repo | echo 'a'
    zypper -n addrepo https://download.opensuse.org/repositories/openSUSE:Factory/standard/openSUSE:Factory.repo | echo 'a'
    zypper refresh
    zypper --no-gpg-checks -n install -y --force-resolution glibc gzip libnuma1 libnuma-devel binutils-gold patchelf
    git clone https://github.com/ROCm/rocm-jax.git
    cd rocm-jax
    git checkout -b mybuild {{ git_hash }
    >>> Get XLA and sed
    cd ..
    git clone https://github.com/ROCm/xla.git
    cd xla
    git checkout -b mybuild {{ cfce2f10011aab8fc85a8419c2b3fd9045439777 }
    sed -i 's/const rocprofiler_tracing_operation_t* hip_ops = nullptr;/rocprofiler_tracing_operation_t* hip_ops = nullptr;/' xla/backends/profiler/gpu/rocm_tracer.cc
    cd ../rocm-jax
    >>> Make sure the compile target is ROCm 6
    !envar JAX_VERSION {{ __version__ }}

    ROCM_MAJOR="${ROCM_RELEASE%%.*}"               # "6" from "6.2.4"
    ROCM_MINOR="${ROCM_RELEASE#*.}"                # "2.4"
    ROCM_MINOR="${ROCM_MINOR%%.*}"                 # "2"

    if [[ "$ROCM_MAJOR" == "6" ]]; then
      sed -i 's/PLUGIN_NAMESPACE_VERSION = "7"/PLUGIN_NAMESPACE_VERSION = "60"/' stack.py
    fi

#    python stack.py develop --rebuild-makefile
    cd jax_rocm_plugin/
#    if [[ "$ROCM_MAJOR" == "6" && "$ROCM_MINOR" -lt 0 ]]; then
    python3 ./build/build.py build \
          --use_clang=true \
          --wheels=jax-rocm-plugin \
          --rocm_path=/opt/rocm/ \
          --rocm_version=60 \
          --rocm_amdgpu_targets=$AMDGPU_TARGETS \
          --local_xla_path "/opt/xla/"
          --verbose \
          --clang_path=/opt/rocm/llvm/bin/clang
#            --bazel_options="--override_repository=xla=../xla --define=xla_rocm_profiler=v1" \
    python3 ./build/build.py build \
        --use_clang=true \
        --wheels=jax-rocm-pjrt \
        --rocm_path=/opt/rocm/ \
        --rocm_version=60 \
        --rocm_amdgpu_targets=$AMDGPU_TARGETS \
        --local_xla_path "/opt/xla/"
        --verbose \
        --clang_path=/opt/rocm/llvm/bin/clang
#          --bazel_options="--override_repository=xla=../xla --define=xla_rocm_profiler=v1" \
#    else
#    make jax_rocm_plugin
#    make jax_rocm_pjrt
#    fi
    cd ../jax/
    python3 ./build/build.py build \
      --target_cpu_features=native \
      --use_clang=true \
      --clang_path=/opt/rocm/llvm/bin/clang \
      --wheels=jaxlib \
      --local_xla_path "/opt/xla/" \
      --verbose
#      --bazel_options="--override_repository=xla=/opt/rocm-jax/xla" \
    cd ../build
    pip install -r requirements.txt
    cd ../jax/dist
    pip install jaxlib*
    cd ../../jax_rocm_plugin/dist
    pip install jax*