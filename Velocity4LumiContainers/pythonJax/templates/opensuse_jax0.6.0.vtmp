@from
    {{ __base__ }}

@run
    >>> Set env variables
    !envar TF_ROCM_AMDGPU_TARGETS gfx90a
    !envar AMDGPU_TARGETS gfx90a

    >>> Add and install required packages
    zypper -n addrepo https://download.opensuse.org/repositories/devel:tools:building/15.6/devel:tools:building.repo
    zypper refresh
    zypper --no-gpg-checks -n install -y --force-resolution glibc gzip libnuma1 libnuma-devel binutils-gold patchelf

    >>> Find ROCm versions
    !envar JAX_VERSION {{ __version__ }}
    ROCM_MAJOR="${ROCM_RELEASE%%.*}"               # "6" from "6.2.4"
    ROCM_MINOR="${ROCM_RELEASE#*.}"                # "2.4"
    ROCM_MINOR="${ROCM_MINOR%%.*}"                 # "2"

    >>> Get XLA and sed if the rocm version is under or equal to v6.2.4
    if [[ "$ROCM_MAJOR" == "6" && "$ROCM_MINOR" -lt 3 ]]; then
      cd /opt/
      git clone https://github.com/ROCm/xla.git
      cd xla
#      git checkout -b mybuild cfce2f10011aab8fc85a8419c2b3fd9045439777 #--> original commit hash pulled by Jax v0.6.0. This commit has the fixes for roctracerv1 partially removed
      git checkout -b mybuild 7775dd04068567dc7e08215de23538da8d1d89f4  # --> needed if we ever need rocprof-v1
  #   Next line is NOT needed for roc-prof-v1 but doesnt seem to do harm
#      sed -i 's/const[[:space:]]\+rocprofiler_tracing_operation_t\*[[:space:]]\+hip_ops/rocprofiler_tracing_operation_t* hip_ops/' xla/backends/profiler/gpu/rocm_profiler_sdk.cc
      # this is needed to disable FP8 on ROCm 6.2.4 and lower because the datatypes are not included in /opt/rocm/include/hip/library_types.h
      sed -i '/^[[:space:]]*return layout\.type() == HIP_R_8F_E5M2_FNUZ[[:space:]]*||/,+2c\
              #ifdef HIP_R_8F_E5M2\
                    return layout.type() == HIP_R_8F_E5M2_FNUZ ||\
                                layout.type() == HIP_R_8F_E4M3_FNUZ ||\
                                layout.type() == HIP_R_8F_E5M2 ||\
                                layout.type() == HIP_R_8F_E4M3;\
              #else\
                      return false;\
              #endif' xla/stream_executor/rocm/hip_blas_lt.cc
    fi

    >>> Get Jax and correct branch
    cd /opt/
    git clone https://github.com/ROCm/rocm-jax.git
    cd rocm-jax
    git checkout -b mybuild {{ git_hash }}

    >>> Fix the ROCm version in the Jax stack.py script
    if [[ "$ROCM_MAJOR" == "6" ]]; then
      sed -i 's/PLUGIN_NAMESPACE_VERSION = "7"/PLUGIN_NAMESPACE_VERSION = "60"/' stack.py
    fi

    >>> Rebuild the makefiles.
    # This is needed even if we don't use the makefile to build Jax because it also pulls the third party dependencies like Jax itself.
    python stack.py develop --rebuild-makefile

    >>> Build Jax
    cd /opt/rocm-jax/jax_rocm_plugin/
    if [[ "$ROCM_MAJOR" == "6" && "$ROCM_MINOR" -lt 3 ]]; then
      python3 ./build/build.py build \
            --use_clang=true \
            --wheels=jax-rocm-plugin \
            --rocm_path=/opt/rocm/ \
            --rocm_version=60 \
            --rocm_amdgpu_targets=$AMDGPU_TARGETS \
            --local_xla_path "/opt/xla/" \
            --verbose \
            --clang_path=/opt/rocm/llvm/bin/clang \
              --bazel_options="--define=xla_rocm_profiler=v1 --define=rocm_enable_hsa_tracer=true --define=rocm_enable_hip_tracer=true"  # --> needed if we ever need rocprof-v1
      python3 ./build/build.py build \
          --use_clang=true \
          --wheels=jax-rocm-pjrt \
          --rocm_path=/opt/rocm/ \
          --rocm_version=60 \
          --rocm_amdgpu_targets=$AMDGPU_TARGETS \
          --local_xla_path "/opt/xla/" \
          --verbose \
          --clang_path=/opt/rocm/llvm/bin/clang \
          --bazel_options="--define=xla_rocm_profiler=v1 --define=rocm_enable_hsa_tracer=true --define=rocm_enable_hip_tracer=true" # --> needed if we ever need rocprof-v1
      >>> Build Jax and Jaxlib
      # v0.6.0 does not have a separate make command for jaxlib and jax.
      cd /opt/rocm-jax/jax/
      python3 ./build/build.py build \
          --target_cpu_features=native \
          --use_clang=true \
          --clang_path=/opt/rocm/llvm/bin/clang \
          --wheels=jaxlib \
          --local_xla_path "/opt/xla/" \
          --verbose \
          --bazel_options="--define=xla_rocm_profiler=v1 --define=rocm_enable_hsa_tracer=true --define=rocm_enable_hip_tracer=true"
    else
      make jax_rocm_plugin
      make jax_rocm_pjrt
      >>> Build Jax and Jaxlib
      # v0.6.0 does not have a separate make command for jaxlib and jax.
      cd /opt/rocm-jax/jax/
      python3 ./build/build.py build \
        --target_cpu_features=native \
        --use_clang=true \
        --clang_path=/opt/rocm/llvm/bin/clang \
        --wheels=jaxlib \
        --verbose
    fi
# For Jax and Jaxlib
#      --bazel_options="--define=xla_rocm_profiler=v1" \ # --> not sure if this is required for rocprof-v1

    >>> Install Jax requirements
    cd /opt/rocm-jax/build
    pip install -r requirements.txt

    >>> Install jaxlib
    cd /opt/rocm-jax/jax/dist
    pip install jaxlib*

    >>> Install plugin and pjrt
    cd /opt/rocm-jax/jax_rocm_plugin/dist
    pip install jax*