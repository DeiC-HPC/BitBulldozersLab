@from
    {{ __base__ }}

@run
    !envar TF_ROCM_AMDGPU_TARGETS gfx90a
    !envar AMDGPU_TARGETS gfx90a
    cd /opt/
    zypper -n addrepo  https://download.opensuse.org/repositories/devel:tools:building/15.6/devel:tools:building.repo | echo 'a'
    zypper -n addrepo https://download.opensuse.org/repositories/openSUSE:Factory/standard/openSUSE:Factory.repo | echo 'a'
    zypper refresh
    zypper --no-gpg-checks -n install -y --force-resolution glibc gzip libnuma1 binutils-gold patchelf
    git clone https://github.com/ROCm/rocm-jax.git
    cd rocm-jax
    git checkout -b mybuild {{ git_hash }}
#    python3 build/ci_build \
#      --python-versions $PYTHON_VERSION \
#      --rocm-version $ROCM_RELEASE \
#      dist_wheels
#    ls jax_rocm_plugin/wheelhouse
#    pip install -r build/requirements.txt
#    pip install jax_rocm_plugin/wheelhouse/jax_*.whl
    python stack.py develop --rebuild-makefile
    cd jax_rocm_plugin/
    make dist
    make jaxlib
    cd ../build
    pip install -r requirements.txt
    cd ../jax/dist
    pip install jaxlib*
    cd ../../jax_rocm_plugin/dist
    pip install jax*