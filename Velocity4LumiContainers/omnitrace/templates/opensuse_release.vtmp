@from
    {{ __base__ }}

@run
  cd /opt/
  wget https://github.com/ROCm/omnitrace/releases/download/v1.13.0/omnitrace-1.13.0-opensuse-15.5-ROCm-60200-PAPI-OMPT-Python3.sh -O omnitrace-installer.sh
  /opt/omnitrace-installer.sh --skip-license --prefix=/opt/omnitrace
  /opt/omnitrace/share/omnitrace/setup-env.sh