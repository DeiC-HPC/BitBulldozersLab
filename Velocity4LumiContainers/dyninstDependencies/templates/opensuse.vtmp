@from
    {{ __base__ }}

@run
  zypper refresh
  >>> Install TBB
  cd /opt
  wget https://github.com/uxlfoundation/oneTBB/releases/download/v2022.3.0/oneapi-tbb-2022.3.0-lin.tgz
  echo "7be34b376c9bdba9afe1ebacaf94ed6dc15af8377d73b539ec932f141195f6ec oneapi-tbb-2022.3.0-lin.tgz" | sha256sum --check --status
  mkdir /opt/tbb
  tar -xvf oneapi-tbb-* -C /opt/tbb --strip-components 1
  rm oneapi-tbb-*
  cd /opt/tbb
  source env/vars.sh
  cd /
  >>> ELF elfutils
  zypper --no-gpg-checks -n install -y --force-resolution elfutils
  >>> Install B2
  cd /opt
  wget https://github.com/bfgroup/b2/releases/download/5.3.3/b2-5.3.3.tar.bz2
  mkdir /opt/b2
  tar -xvf b2-* -C /opt/b2 --strip-components 1
  cd /opt/b2
  ./bootstrap.sh
  ./b2 install --prefix=/bin/
  >>> Install boost
  wget https://archives.boost.io/release/1.89.0/source/boost_1_89_0.tar.bz2
  mkdir /opt/boost
  tar -xvf boost_* -C /opt/boost --strip-components 1
  rm boost_*
  cd boost
  ./bootstrap.sh --prefix=/usr/local
  ./b2
  ./b2 install
